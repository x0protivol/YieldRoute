# YieldRoute - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains private keys!

# ============================================================
# SELLER WALLET - AI Node (server.js)
# This wallet receives x402 nanopayment revenue from DeFi bots
# ============================================================
SELLER_WALLET_ADDRESS=0xYourSellerWalletAddressHere
SELLER_PRIVATE_KEY=0xYourSellerPrivateKeyHere

# ============================================================
# BUYER WALLET - Aave Protocol Bot (aave_bidder.js)
# This wallet sponsors AI compute costs via x402 payments
# Fund this wallet with USDC on Arc L1 Testnet
# ============================================================
BUYER_WALLET_ADDRESS=0xYourBuyerWalletAddressHere
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKeyHere

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
AI_NODE_URL=http://localhost:3000

# ============================================================
# CIRCLE CONFIGURATION
# ============================================================
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_NETWORK=arcTestnet

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
# 1. Install CLI: npm install -g @circle-fin/cli
# 2. Login:       circle wallet login --testnet
# 3. Create wallets:
#    circle wallet create --output json  (Seller)
#    circle wallet create --output json  (Buyer)
# 4. Fund buyer:
#    circle wallet fund --address <BUYER_ADDRESS> --chain ARC-TESTNET
#    circle gateway deposit --amount 10 --address <BUYER_ADDRESS> --chain ARC-TESTNET --method direct
# 5. Copy addresses and private keys into this file
# 6. Run: node server.js (in Terminal 1)
# 7. Run: node aave_bidder.js (in Terminal 2)
# 8. Run: node check_balance.js (in Terminal 3 for demo)
