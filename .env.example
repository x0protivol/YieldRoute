# YieldRoute - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains private keys!

# ============================================================
# SELLER WALLET - AI Node (server.js)
# This wallet receives x402 nanopayment revenue from DeFi bots
# ============================================================
SELLER_WALLET_ADDRESS=0xYourSellerWalletAddressHere
SELLER_PRIVATE_KEY=0xYourSellerPrivateKeyHere

# ============================================================
# BUYER WALLET - Aave Protocol Bot (aave_bidder.js)
# This wallet sponsors AI compute costs via x402 payments
# Fund this wallet with USDC on Arc L1 Testnet
# ============================================================
BUYER_WALLET_ADDRESS=0xYourBuyerWalletAddressHere
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKeyHere

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
AI_NODE_URL=http://localhost:3000

# ============================================================
# CIRCLE CONFIGURATION
# ============================================================
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_NETWORK=arcTestnet

# ============================================================
# ARC L1 TESTNET - BLOCKCHAIN DEPLOYMENT
# Chain ID: 5042002
# RPC URL: https://rpc.testnet.arc.network
# Explorer: https://testnet.arcscan.app
# Native Gas: USDC (not ETH!) - get free USDC at faucet.circle.com
# ============================================================
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_EXPLORER_API_KEY=your_arcscan_api_key_here

# Your deployer wallet private key (same as SELLER or a new wallet)
# FUND THIS WALLET AT: https://faucet.circle.com (select Arc Testnet)
DEPLOYER_PRIVATE_KEY=0xYourDeployerPrivateKeyHere
DEPLOYER_ADDRESS=0xYourDeployerAddressHere

# After running: npx hardhat run scripts/deploy.js --network arcTestnet
# Paste the deployed contract address below:
YIELDROUTE_CONTRACT_ADDRESS=

# USDC token address on Arc L1 Testnet (official)
ARC_TESTNET_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ============================================================
# FULL DEPLOYMENT STEPS (copy-paste these commands)
# ============================================================
# 1. Install CLI: npm install -g @circle-fin/cli
# 2. Login:       circle wallet login --testnet
# 3. Create wallets:
#    circle wallet create --output json  (Seller)
#    circle wallet create --output json  (Buyer/Deployer)
# 4. Fund deployer from Arc Testnet Faucet:
#    Visit: https://faucet.circle.com
#    Select: USDC + Arc Testnet
#    Enter your DEPLOYER_ADDRESS
#    Click: Send 20 USDC
# 5. Install Hardhat dependencies:
#    npm install --save-dev @nomicfoundation/hardhat-toolbox
# 6. Deploy to Arc L1 Testnet:
#    npx hardhat run scripts/deploy.js --network arcTestnet
# 7. Copy contract address from output to YIELDROUTE_CONTRACT_ADDRESS above
# 8. Verify on explorer:
#    https://testnet.arcscan.app/address/<YOUR_CONTRACT_ADDRESS>
# 9. Run: node server.js (in Terminal 1)
# 10. Run: node aave_bidder.js (in Terminal 2)
# 11. Run: node check_balance.js (in Terminal 3 for demo)
